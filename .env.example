# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# ScrapeCreators API key (same key Reel Trax uses: Reel Trax -> Settings, or scrapecreators.com dashboard)
SCRAPECREATORS_API_KEY=

# When to run the daily check. 20 = 8 PM. Timezone is an IANA name.
REMINDER_HOUR=20
TIMEZONE=America/New_York

# Where creator records are stored (JSON). Default: ./data/creators.json
# DATA_FILE=./data/creators.json
